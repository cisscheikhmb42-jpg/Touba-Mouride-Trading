# =====================================================================
# TOUBA MOURIDE TRADING — variables d'environnement
# Copier en .env.local (local) et renseigner dans Vercel > Settings >
# Environment Variables (production). NE JAMAIS committer de vraies clés.
# =====================================================================

# URL publique du site (sans / final) — sert aux URL canoniques, au sitemap
# et aux données structurées. Ex. : https://www.toubamouridetrading.com
NEXT_PUBLIC_SITE_URL=

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (anon / publishable). Protégée par les politiques RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aucune clé service_role n'est nécessaire au fonctionnement du site :
# toutes les opérations passent par la clé publique + RLS + fonctions SQL.
# Si un script d'administration en a besoin un jour, elle devra rester
# côté serveur, SANS préfixe NEXT_PUBLIC_, et ne jamais être commitée.
# SUPABASE_SERVICE_ROLE_KEY=

# Intelligence artificielle (facultatif, désactivé si vide).
# Les appels se font uniquement côté serveur.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_MAX_REQUESTS_PER_HOUR=30
